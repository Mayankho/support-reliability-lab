NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://app:app@localhost:5432/support_reliability
MODEL_ENABLED=false
ALLOW_EXTERNAL_CALLS=false
USE_SYNTHETIC_FIXTURES=true
EVAL_DEFAULT_DATASET=v1
EVAL_MAX_CONCURRENCY=4
EVAL_CASE_TIMEOUT_MS=5000
EVAL_MAX_CASES=100
# console prints OpenTelemetry spans and metrics; none keeps them off
OTEL_EXPORTER=none
LOG_LEVEL=info
# local: no authentication, single workspace ws_demo (development only, refused in production)
# jwt: run `pnpm auth:init`, then set the three JWT_* values it prints
AUTH_MODE=local
# JWT_ISSUER=srl-local-issuer
# JWT_AUDIENCE=srl-api
# JWT_JWKS_FILE=/absolute/path/to/.local-auth/jwks.json
