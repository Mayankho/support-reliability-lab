{
  "name": "support-reliability-lab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:integration": "pnpm -r --workspace-concurrency=1 --if-present test:integration",
    "dev": "pnpm --filter @srl/api dev",
    "db:migrate": "node packages/db/src/cli/migrate.ts",
    "seed": "node packages/runner/src/cli/seed.ts",
    "eval:validate-data": "node packages/dataset/src/cli/validate-data.ts",
    "eval:run": "node packages/runner/src/cli/eval-run.ts",
    "eval:gate": "node packages/runner/src/cli/eval-gate.ts",
    "demo": "node packages/runner/src/cli/demo.ts",
    "worker": "node packages/runner/src/cli/worker.ts",
    "alerts:check": "node packages/runner/src/cli/alerts-check.ts",
    "auth:init": "node apps/api/src/cli/auth-dev.ts init",
    "auth:token": "node apps/api/src/cli/auth-dev.ts token",
    "scan:sensitive": "node packages/dataset/src/cli/scan-sensitive.ts",
    "tickets:validate-taxonomy": "node packages/ticket-analysis/src/cli/validate-taxonomy.ts",
    "tickets:coverage": "node packages/ticket-analysis/src/cli/coverage.ts",
    "tickets:demo": "node packages/ticket-analysis/src/cli/demo.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
